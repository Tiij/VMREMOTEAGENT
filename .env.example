# Pour démarrer sans inférence IA, cette valeur peut rester vide.
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash
HOSTNAME_PUBLIQUE=localhost
CODE_SERVER_PASSWORD=remplacez-par-un-mot-de-passe-long
# 2 Go de RAM : un agent à la fois, aucun modèle local.
CLOUDCLI_MEMORY_LIMIT=1400m
CLOUDCLI_SWAP_LIMIT=2g
SNAPSHOT_KEEP=3
