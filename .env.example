# Exemple public : copier ce fichier vers .env, puis remplir les valeurs.
# Debian : cp .env.example .env
# PowerShell : Copy-Item .env.example .env
# Ne pas publier le fichier .env rempli.

# Clé créée sur https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash
# Mettre 1 uniquement pour tester les services sans clé API.
ALLOW_NO_API_KEY=0

# Local : localhost. Freebox : adresse IP de la VM Debian, sans https://.
HOSTNAME_PUBLIQUE=localhost
BIND_ADDRESS=0.0.0.0
# Remplacer cette valeur par un mot de passe long pour l'IDE.
CODE_SERVER_PASSWORD=remplacez-par-un-mot-de-passe-long

# 2 Go de RAM : un agent à la fois, aucun modèle local.
CLOUDCLI_MEMORY_LIMIT=1400m
CLOUDCLI_SWAP_LIMIT=2g
# Nombre de sauvegardes conservées par le script de sauvegarde automatique.
SNAPSHOT_KEEP=3
